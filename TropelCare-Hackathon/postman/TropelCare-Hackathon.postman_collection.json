{
  "info": {"name":"TropelCare Hackathon","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8080"},{"key":"sectorId","value":"1"},{"key":"tropelId","value":"1"},{"key":"signalId","value":"1"},{"key":"signal2Id","value":"2"}],
  "item":[
    {"name":"1. Guardians","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/guardians","host":["{{baseUrl}}"],"path":["api","v1","guardians"]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"2. Create Sector","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"sectorCode\": \"SECTOR-7\",\n  \"climate\": \"RETRO_ARCADE\",\n  \"capacity\": 1\n}"},"url":"{{baseUrl}}/api/v1/sectors"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('sectorId',pm.response.json().id);"]}}]},
    {"name":"3. Create Tropel","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"BipBop\",\n  \"species\": \"GLITCHY\",\n  \"sectorId\": {{sectorId}},\n  \"guardianId\": 1\n}"},"url":"{{baseUrl}}/api/v1/tropels"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('tropelId',pm.response.json().id);"]}}]},
    {"name":"4. Get Sector","request":{"method":"GET","url":"{{baseUrl}}/api/v1/sectors/{{sectorId}}"}},
    {"name":"5. Sector Full","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"BipBop-2\",\"species\":\"GLITCHY\",\"sectorId\":{{sectorId}},\"guardianId\":1}"},"url":"{{baseUrl}}/api/v1/tropels"},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));"]}}]},
    {"name":"6. Signal Hunger","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"tropelId\": {{tropelId}},\n  \"guardianId\": 1,\n  \"senderTag\": \"sensor-norte-7\",\n  \"rawContent\": \"BipBop lleva 3 ciclos sin recibir nutrientes y ha empezado a morder los bordes del sector digital.\"\n}"},"url":"{{baseUrl}}/api/v1/signals"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('signalId',pm.response.json().id);"]}}]},
    {"name":"7. Tropel Updated","request":{"method":"GET","url":"{{baseUrl}}/api/v1/tropels/{{tropelId}}"}},
    {"name":"8. Care Response","request":{"method":"GET","url":"{{baseUrl}}/api/v1/signals/{{signalId}}/care-response"}},
    {"name":"9. Signal Mutation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"tropelId\": {{tropelId}},\n  \"guardianId\": 1,\n  \"senderTag\": \"sensor-genetico-1\",\n  \"rawContent\": \"BipBop emite un brillo verde anómalo. Se han detectado dos extremidades adicionales que no existían en el registro inicial.\"\n}"},"url":"{{baseUrl}}/api/v1/signals"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('signal2Id',pm.response.json().id);"]}}]},
    {"name":"10. Get Signal","request":{"method":"GET","url":"{{baseUrl}}/api/v1/signals/{{signal2Id}}"}},
    {"name":"11. Wrong Guardian","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"tropelId\":{{tropelId}},\"guardianId\":99,\"senderTag\":\"sensor-test\",\"rawContent\":\"Prueba de validación de guardián incorrecto.\"}"},"url":"{{baseUrl}}/api/v1/signals"},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));"]}}]},
    {"name":"12. Filter Signals","request":{"method":"GET","url":"{{baseUrl}}/api/v1/signals?signalType=HAMBRE&page=0&size=10"}},
    {"name":"13. Filter Tropels","request":{"method":"GET","url":"{{baseUrl}}/api/v1/tropels?vitalState=ESTABLE&page=0&size=10"}},
    {"name":"14. Notifications","request":{"method":"GET","url":"{{baseUrl}}/api/v1/signals/{{signalId}}/notifications"}},
    {"name":"15. Diary","request":{"method":"GET","url":"{{baseUrl}}/api/v1/tropels/{{tropelId}}/diary"}}
  ]
}
